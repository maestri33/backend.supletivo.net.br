[Unit]
Description=Cloudflare Tunnel Connector (supletivo-prod)
Documentation=https://developers.cloudflare.com/cloudflare-one/connections/connect-apps
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
TimeoutStartSec=30
TimeoutStopSec=30
ExecStart=/usr/local/bin/cloudflared tunnel --config /etc/cloudflared/config.yml --logfile /var/log/cloudflared/cloudflared.log --loglevel info --transport-loglevel warn run
Restart=always
RestartSec=5s
WatchdogSec=30s

# Hardening e Privilégios Mínimos
User=cloudflared
Group=cloudflared
WorkingDirectory=/etc/cloudflared
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/log/cloudflared /etc/cloudflared

# Otimizações de Recursos
LimitNOFILE=65536
KillMode=mixed

[Install]
WantedBy=multi-user.target
