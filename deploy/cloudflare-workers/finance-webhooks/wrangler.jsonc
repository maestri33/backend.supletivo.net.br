{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "supletivo-finance-webhooks",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "webhooks.v7m.live/bank/*",
      "zone_name": "v7m.live"
    }
  ],
  "queues": {
    "producers": [
      {
        "queue": "finance-webhooks-queue",
        "binding": "FINANCE_WEBHOOKS_QUEUE"
      }
    ],
    "consumers": [
      {
        "queue": "finance-webhooks-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "finance-webhooks-dlq"
      }
    ]
  },
  "vars": {
    "BACKEND_INGEST_URL": "https://backend.supletivo.net.br/api/internal/webhooks/ingest/"
  }
}
