{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "supletivo-finance-webhooks",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "webhooks.v7m.live",
      "custom_domain": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "FINANCE_WEBHOOKS_KV",
      "id": "e6e7396050df469895c6cdd071a360b1"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "v7m-webhooks",
      "database_id": "c10a46d6-1ab1-4cdd-bdb6-421a8f01d852"
    }
  ],
  "queues": {
    "producers": [
      {
        "queue": "finance-webhooks-queue",
        "binding": "FINANCE_WEBHOOKS_QUEUE"
      }
    ],
    "consumers": [
      {
        "queue": "finance-webhooks-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "finance-webhooks-dlq"
      }
    ]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "BACKEND_ASAAS_URL": "https://backend.supletivo.net.br/integrations/asaas/webhook/",
    "BACKEND_INFINITEPAY_URL": "https://backend.supletivo.net.br/integrations/infinitepay/webhook/",
    "BACKEND_HEALTH_URL": "https://backend.supletivo.net.br/api/v1/health/"
  }
}
